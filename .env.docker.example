# Environment for the Docker deployments. Copy, then fill in:
#
#   cp .env.docker.example .env.docker         # local demo  (docker-compose.yml)
#   cp .env.docker.example .env.production     # HTTPS       (docker-compose.prod.yml)
#
# Both copies are gitignored. Never commit a filled-in one.

# ── Secrets: generate each ONCE and keep them ────────────────────────────────
# Keys the HMAC on one-time codes, sharing codes and verification IDs.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Encrypts two-step-verification secrets in the database (auth/crypto.py).
#   docker compose run --rm prescriptai python manage.py new-key
# To rotate: put the NEW key first, keep the old one after a comma.
# If left empty a key is derived from SECRET_KEY, which then must never change.
DATA_ENCRYPTION_KEY=

# ── The reader ───────────────────────────────────────────────────────────────
# Empty = the mock reader (no spend; the UI says "Demo reader").
# Paste a key and `docker compose up -d` to read real handwriting.
ANTHROPIC_API_KEY=
# Hard ceiling in USD on API spend. Reads are refused past it.
PRESCRIPTAI_SPEND_CAP=5

# ── Delivering codes (HTTPS deployment; the local demo uses Mailpit) ─────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@yourdomain.in
#
# Phone codes: twilio | webhook | email | console   (auth/notify.py)
# SMS_DELIVERY=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
